# Compass — live price check (optional, additive; see docs/02-architecture.md).
# Copy this file to .env.local (never committed) and fill in real values once
# they exist. With none of these set, the app behaves exactly as it does today:
# no network calls, no "live price check" section on the plan screen.

# Travelpayouts real-time flight search (travelpayouts.github.io/slate).
VITE_TRAVELPAYOUTS_TOKEN=your-travelpayouts-api-token
VITE_TRAVELPAYOUTS_MARKER=your-travelpayouts-affiliate-marker

# Booking.com Demand API v3 (Partner Hub). Field mapping is unverified until we
# have real access — see the comment at the top of src/data/livePrices/bookingProvider.ts.
VITE_BOOKING_API_KEY=your-booking-demand-api-bearer-token
VITE_BOOKING_AFFILIATE_ID=your-booking-affiliate-id
